{"data":{"content":"\"\"\"Lab 0: Getting Started.\"\"\"\n\n\ndef twenty_twenty_six():\n    \"\"\"Come up with the most creative expression that evaluates to 2026\n    using only numbers and the +, *, and - operators (or ** and % if you'd like).\n\n    >>> twenty_twenty_six()\n    2026\n    \"\"\"\n    return ______\n","line_count":12,"path":"lab00.py","sha256":"82335c78fdc41b72cd75854bed2d2c73647bf57f119f2b813ac37007375bd49b"},"hash":"9f4dcbf7f3be88cf835a657534aa99a0c6118c085f61b270b60470f002cdaa94","kind":"doc.open","prev_hash":"8a855cb3e0d628e7a7d638346ac2b04bc47eefa0b6a48301372be4cf9260cd89","seq":21,"t":96541,"wall":"2026-08-30T14:25:40.436Z"}
